ErrorDocument 404 /404.php
ErrorDocument 403 /403.php
ErrorDocument 401 /401.php

RewriteEngine On
# Every visit ends up on https://www.sorwatom.com: the bare domain moves to www,
# and plain HTTP on www moves to HTTPS. X-Forwarded-Proto covers hosts whose
# proxy handles HTTPS before Apache sees the request.
RewriteCond %{HTTP_HOST} ^sorwatom\.com$ [NC]
RewriteRule ^(.*)$ https://www.sorwatom.com/$1 [R=301,L]
RewriteCond %{HTTP_HOST} ^www\.sorwatom\.com$ [NC]
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
RewriteRule ^(.*)$ https://www.sorwatom.com/$1 [R=301,L]
RewriteOptions inherit

# ── Security headers ────────────────────────────────────────
<IfModule mod_headers.c>
    Header always set X-Frame-Options "DENY"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    # Scripts only from files on this site, so injected <script> or onclick="…" code
    # never runs. The one hash allows the newsletter-cron ping at the end of
    # partials/footer.php exactly as written; if that script changes, its new hash
    # is printed by: php -r 'preg_match("#<script>(.*?)</script>#s", file_get_contents("partials/footer.php"), $m); echo "sha256-", base64_encode(hash("sha256", $m[1], true)), PHP_EOL;'
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-JqMJFdcjSrl5xgKf5tiLz6Bin7xMsjIQIXUez24nSEI='; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https:; connect-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests"
</IfModule>

# ── Block direct access to sensitive / deployment files ─────
<FilesMatch "^(about|product)-template\.php$">
    Order deny,allow
    Deny from all
</FilesMatch>
<FilesMatch "^(error_log|Dockerfile|fly\.toml|router\.php|\.gitignore|secrets(\.example)?\.php)$">
    Require all denied
</FilesMatch>
<FilesMatch "\.(md)$">
    Require all denied
</FilesMatch>

# ── Gzip / Deflate compression ──────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
    AddOutputFilterByType DEFLATE application/javascript application/json
    AddOutputFilterByType DEFLATE font/woff font/woff2
</IfModule>

# ── Serve WebP to browsers that support it ──────────────────
# slider/ and products/ images all have .webp counterparts.
AddType image/webp .webp
<IfModule mod_rewrite.c>
  RewriteCond %{HTTP_ACCEPT} image/webp
  RewriteRule ^(assets/img/(?:slider|products)/[^/]+)\.(jpe?g|png)$ /$1.webp [T=image/webp,L,NC]
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(jpe?g|png)$">
    Header append Vary Accept
  </FilesMatch>
</IfModule>

# ── Browser caching for static assets ───────────────────────
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css                  "access plus 1 month"
    ExpiresByType application/javascript    "access plus 1 month"
    ExpiresByType image/png                 "access plus 6 months"
    ExpiresByType image/jpeg                "access plus 6 months"
    ExpiresByType image/webp                "access plus 6 months"
    ExpiresByType image/svg+xml             "access plus 6 months"
    ExpiresByType font/woff                 "access plus 1 year"
    ExpiresByType font/woff2                "access plus 1 year"
    ExpiresByType application/font-woff     "access plus 1 year"
    ExpiresByType application/font-woff2    "access plus 1 year"
</IfModule>

# ── Clean URL routing ──────────────────────────────────────
# Addresses of the previous sorwatom.com site that Google already knows: send
# visitors (and their search ranking) to the matching new page instead of a 404.
RewriteRule ^about-us(?:\.php)?/?$     /about    [R=301,L,NC]
RewriteRule ^about-vision(?:\.php)?/?$ /about    [R=301,L,NC]
RewriteRule ^about-team(?:\.php)?/?$   /about    [R=301,L,NC]
RewriteRule ^contact-us(?:\.php)?/?$   /contact  [R=301,L,NC]
RewriteCond %{THE_REQUEST} \s/+index(?:\.php)?[\s?] [NC]
RewriteRule ^ / [R=301,L]

# Redirect /page.php → /page (removes .php from browser bar)
# Skip POST requests — a 301 would convert POST to GET and lose form data
RewriteCond %{REQUEST_METHOD} !POST
RewriteCond %{THE_REQUEST} \s/+(.+?)\.php[\s?] [NC]
RewriteRule ^ /%1 [R=301,L,NE]

# RSS feed: /feed → feed.php
RewriteRule ^feed/?$ feed.php [L]

# Sitemap
RewriteRule ^sitemap\.xml$ sitemap.php [L]

# Blog post: /blog/slug → blog-post.php?slug=slug
RewriteRule ^blog/([a-zA-Z0-9_-]+)/?$ blog-post.php?slug=$1 [L,QSA]

# Serve /page as page.php if the file exists
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^([^.]+)$ $1.php [L]

# If no file or .php match found — serve 404 page
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ /404.php [L]
